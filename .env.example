# Copy this file to .env and fill in the values. All of them are required.

# Port where the server listens
PORT=8080

# Gencat open data API (https://analisi.transparenciacatalunya.cat)
APP_TOKEN=your-app-token
GENCAT_EVENTS_URL=https://analisi.transparenciacatalunya.cat/api/v3/views/rhpv-yr4f/query.json
GENCAT_PAGE_SIZE=10

# Firebase Admin SDK: path to the service account JSON (Firebase console > Project settings > Service accounts)
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json

# Postgres database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password
DB_DATABASE=aprop
# Optional: disable (default), require, verify-ca, verify-full
DB_SSLMODE=disable
# Optional: maximum number of connections in the pool
DB_POOL_SIZE=10

# Chatbot: Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Chatbot: catalogue MCP server (cmd/mcp). The API calls it with the shared token.
MCP_PORT=8081
MCP_URL=http://localhost:8081/mcp
MCP_TOKEN=change-me-shared-secret
