# Copy this file to .env and fill in the values. All of them are required.

# Port where the server listens
PORT=8080
# Optional: comma separated origins that can call the API from a browser (CORS). * (default) allows any origin.
# Example to restrict it: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://admin.aprop.cat
CORS_ALLOWED_ORIGINS=*

# Gencat open data API (https://analisi.transparenciacatalunya.cat)
APP_TOKEN=your-app-token
GENCAT_EVENTS_URL=https://analisi.transparenciacatalunya.cat/api/v3/views/rhpv-yr4f/query.json
GENCAT_PAGE_SIZE=10

# Firebase Admin SDK: path to the service account JSON (Firebase console > Project settings > Service accounts)
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
# Firebase Web API key (Firebase console > Project settings > General): sends the password reset emails.
# Optional: without it POST /auth/password-reset answers 503
FIREBASE_WEB_API_KEY=

# Postgres database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password
DB_DATABASE=aprop
# Optional: disable (default), require, verify-ca, verify-full
DB_SSLMODE=disable
# Optional: maximum number of connections in the pool
DB_POOL_SIZE=10

# Chatbot: Groq API (https://console.groq.com/keys)
# GROQ_API_KEYS supports comma-separated keys for automatic failover and load balancing
GROQ_API_KEYS=your-groq-api-key-1,your-groq-api-key-2
GROQ_MODEL=openai/gpt-oss-120b

# Chatbot: Google Gemini API (https://aistudio.google.com/)
# Backup used when every Groq key fails (OpenAI compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Event translations (US #28): translation service URL (POST /translate), e.g. Cloudflare Workers AI translator
# Optional: without it GET endpoints with ?lang=es|en (or a user language other than ca) return the original Catalan text
TRANSLATOR_URL=
# Optional: only if the translator requires an API key
TRANSLATOR_API_KEY=

# Mobilicat (PES): API key that Mobilicat sends in the X-API-Key header to POST /api/v1/congestion/estimate.
# Optional: without it the endpoint answers 503.
MOBILICAT_API_KEY=
# Optional: constant K of the congestion factor 0.1 + 0.9·(1 − e^(−score/K)). Defaults to 20.
MOBILICAT_CONGESTION_K=20

# Talaia: Provides astronomical events
TALAIA_API_KEY=
TALAIA_EVENTS_URL=